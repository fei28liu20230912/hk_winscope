defines = -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I.. -I../src/profiling/memory/include -I../include -Iwasm_memory64/gen/build_config -Iwasm_memory64/gen
cflags = -fstrict-aliasing -Wformat -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -fno-omit-frame-pointer -msimd128 -s MEMORY64=1 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_c =
root_out_dir = wasm_memory64
target_output_name = grammar

build wasm_memory64/obj/src/trace_processor/perfetto_sql/preprocessor/grammar.inputdeps.stamp: wasm_memory64_stamp wasm_memory64/obj/gn/gen_buildflags.stamp wasm_memory64/obj/gn/standalone/check_build_deps.stamp
build wasm_memory64/obj/src/trace_processor/perfetto_sql/preprocessor/grammar.preprocessor_grammar.o: wasm_memory64_cc ../src/trace_processor/perfetto_sql/preprocessor/preprocessor_grammar.c || wasm_memory64/obj/src/trace_processor/perfetto_sql/preprocessor/grammar.inputdeps.stamp

build wasm_memory64/obj/src/trace_processor/perfetto_sql/preprocessor/grammar.stamp: wasm_memory64_stamp wasm_memory64/obj/src/trace_processor/perfetto_sql/preprocessor/grammar.preprocessor_grammar.o || wasm_memory64/obj/gn/default_deps.stamp
