defines = -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I.. -I../src/profiling/memory/include -I../include -Iwasm_memory64/gen/build_config -Iwasm_memory64/gen
cflags = -fstrict-aliasing -Wformat -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -fno-omit-frame-pointer -msimd128 -s MEMORY64=1 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -std=c++17
root_out_dir = wasm_memory64
target_output_name = generator

build wasm_memory64/obj/src/trace_processor/perfetto_sql/generator/generator.inputdeps.stamp: wasm_memory64_stamp wasm_memory64/obj/gn/gen_buildflags.stamp wasm_memory64/obj/gn/standalone/check_build_deps.stamp wasm_memory64/obj/protos/perfetto/perfetto_sql/zero_gen.stamp
build wasm_memory64/obj/src/trace_processor/perfetto_sql/generator/generator.structured_query_generator.o: wasm_memory64_cxx ../src/trace_processor/perfetto_sql/generator/structured_query_generator.cc || wasm_memory64/obj/src/trace_processor/perfetto_sql/generator/generator.inputdeps.stamp

build wasm_memory64/obj/src/trace_processor/perfetto_sql/generator/generator.stamp: wasm_memory64_stamp wasm_memory64/obj/src/trace_processor/perfetto_sql/generator/generator.structured_query_generator.o || wasm_memory64/obj/gn/default_deps.stamp wasm_memory64/obj/protos/perfetto/perfetto_sql/zero.stamp wasm_memory64/obj/src/base/base.stamp wasm_memory64/obj/src/protozero/protozero.stamp wasm_memory64/obj/src/trace_processor/util/util.stamp wasm_memory64/obj/include/perfetto/base/base.stamp wasm_memory64/obj/include/perfetto/public/base.stamp wasm_memory64/obj/include/perfetto/public/abi/base.stamp wasm_memory64/obj/include/perfetto/protozero/protozero.stamp wasm_memory64/obj/include/perfetto/public/protozero.stamp wasm_memory64/obj/include/perfetto/ext/base/base.stamp wasm_memory64/obj/src/base/perfetto_base_default_platform.stamp wasm_memory64/obj/include/perfetto/trace_processor/basic_types.stamp
