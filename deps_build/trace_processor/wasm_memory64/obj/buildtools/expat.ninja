defines = -D_LIB -DHAVE_EXPAT_CONFIG_H -DNDEBUG -DXML_STATIC
include_dirs =
cflags = -fstrict-aliasing -Wformat -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -fno-omit-frame-pointer -msimd128 -s MEMORY64=1 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections -Wno-format -isystem ../buildtools/expat/src/expat/lib -isystem ../buildtools/expat/include
cflags_c =
root_out_dir = wasm_memory64
target_output_name = expat

build wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmlparse.o: wasm_memory64_cc ../buildtools/expat/src/expat/lib/xmlparse.c
build wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmlrole.o: wasm_memory64_cc ../buildtools/expat/src/expat/lib/xmlrole.c
build wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmltok.o: wasm_memory64_cc ../buildtools/expat/src/expat/lib/xmltok.c

build wasm_memory64/obj/buildtools/expat.stamp: wasm_memory64_stamp wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmlparse.o wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmlrole.o wasm_memory64/obj/buildtools/expat/src/expat/lib/expat.xmltok.o
