defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DGTEST_LANG_CXX11=1 -DGOOGLE_PROTOBUF_NO_RTTI -DGOOGLE_PROTOBUF_NO_STATIC_INITIALIZER -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -I../buildtools/googletest/googletest/include -I../buildtools/googletest/googlemock/include -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Weverything -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -Wthread-safety -Wno-thread-safety-negative -fvisibility=hidden -O3 -fdata-sections -ffunction-sections -Wno-covered-switch-default -Wno-deprecated-copy-dtor -Wno-global-constructors -Wno-inconsistent-missing-override -Wno-language-extension-token -Wno-suggest-destructor-override -Wno-suggest-override -Wno-undef -Wno-unknown-warning-option -Wno-unused-member-function -Wno-used-but-marked-unused -Wno-weak-vtables -Wno-zero-as-null-pointer-constant -isystem ../buildtools/protobuf/src
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = unittests

build obj/src/protovm/unittests.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/protovm/lite_gen.stamp obj/protos/perfetto/protovm/zero_gen.stamp obj/src/protovm/test_messages_lite_gen.stamp
build obj/src/protovm/test/unittests.allocator_unittest.o: cxx ../src/protovm/test/allocator_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.parser_unittest.o: cxx ../src/protovm/test/parser_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.ro_cursor_unittest.o: cxx ../src/protovm/test/ro_cursor_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.rw_proto_unittest.o: cxx ../src/protovm/test/rw_proto_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.slab_allocator_unittest.o: cxx ../src/protovm/test/slab_allocator_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.utils.o: cxx ../src/protovm/test/utils.cc || obj/src/protovm/unittests.inputdeps.stamp
build obj/src/protovm/test/unittests.vm_unittest.o: cxx ../src/protovm/test/vm_unittest.cc || obj/src/protovm/unittests.inputdeps.stamp

build obj/src/protovm/unittests.stamp: stamp obj/src/protovm/test/unittests.allocator_unittest.o obj/src/protovm/test/unittests.parser_unittest.o obj/src/protovm/test/unittests.ro_cursor_unittest.o obj/src/protovm/test/unittests.rw_proto_unittest.o obj/src/protovm/test/unittests.slab_allocator_unittest.o obj/src/protovm/test/unittests.utils.o obj/src/protovm/test/unittests.vm_unittest.o || obj/src/protovm/protovm.stamp obj/src/protovm/test_messages_lite.stamp obj/gn/default_deps.stamp obj/gn/gtest_and_gmock.stamp obj/protos/perfetto/protovm/lite.stamp obj/protos/perfetto/protovm/zero.stamp obj/src/base/base.stamp obj/src/base/test_support.stamp obj/src/protozero/protozero.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp obj/buildtools/protobuf_lite.stamp obj/buildtools/gmock.stamp obj/buildtools/gtest.stamp
