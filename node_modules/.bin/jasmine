#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/administrator/hulk/winscope/node_modules/.pnpm/jasmine@4.3.0/node_modules/jasmine/node_modules:/home/administrator/hulk/winscope/node_modules/.pnpm/jasmine@4.3.0/node_modules:/home/administrator/hulk/winscope/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/administrator/hulk/winscope/node_modules/.pnpm/jasmine@4.3.0/node_modules/jasmine/node_modules:/home/administrator/hulk/winscope/node_modules/.pnpm/jasmine@4.3.0/node_modules:/home/administrator/hulk/winscope/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../jasmine/bin/jasmine.js" "$@"
else
  exec node  "$basedir/../jasmine/bin/jasmine.js" "$@"
fi
